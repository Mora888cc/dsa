-- CONFIG
-- ============================================================
local CONFIG_DIR = "OJBS"
local CONFIG_PATH = CONFIG_DIR .. "/abilityarena.json"
local CONFIG_VERSION = 1

local function deepCopy(tbl)
    local copy = {}
    for k, v in pairs(tbl) do
        copy[k] = type(v) == "table" and deepCopy(v) or v
    end
    return copy
end

local function ensureDir()
    if isfolder and not isfolder(CONFIG_DIR) then
        makefolder(CONFIG_DIR)
    end
end

local Defaults = {
    version = CONFIG_VERSION,
    theme = "Crimson",
    uiScale = 1,
    openKey = Enum.KeyCode.RightShift,
    features = {},
    settings = {
        theme = "Crimson",
        animations = true,
        uiScale = 1,
        openKey = Enum.KeyCode.RightShift,
    },
}

local Config = deepCopy(Defaults)

local function serializeSave()
    if not writefile then return end
    ensureDir()
    local copy = deepCopy(Config)
    copy.settings.openKey = Config.settings.openKey.Name
    writefile(CONFIG_PATH, HttpService:JSONEncode(copy))
end

local function serializeLoad()
    if not readfile or not isfile then return end
    ensureDir()
    if not isfile(CONFIG_PATH) then return end
    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile(CONFIG_PATH))
    end)
    if not ok or type(data) ~= "table" then return end
    Config = deepCopy(Defaults)
    Config.features = data.features or {}
    for k, v in pairs(data.settings or {}) do
        if pcall(function() return v end) then
            Config.settings[k] = v
        end
    end
    if Config.settings.openKey then
        local name = Config.settings.openKey
        if typeof(name) == "string" then
            local ok2, key = pcall(function() return Enum.KeyCode[name] end)
            if ok2 then Config.settings.openKey = key end
        end
    end
end

serializeLoad()

