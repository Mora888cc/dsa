function UILib.Keybind(parent, label, default, callback)
    local row = new("Frame", {
        Size = UDim2.new(1, 0, 0, 28),
        BackgroundTransparency = 1,
    }, parent)
    new("TextLabel", {
        Size = UDim2.new(0.5, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = label,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextColor3 = Theme.text,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)
    local text = typeof(default) == "EnumItem" and default.Name or tostring(default)
    local btn = new("TextButton", {
        Size = UDim2.new(0, 90, 0, 22),
        Position = UDim2.new(1, -90, 0.5, -11),
        BackgroundColor3 = Theme.panelLight,
        Text = text,
        Font = Enum.Font.GothamMedium,
        TextSize = 11,
        TextColor3 = Theme.accentLight,
        AutoButtonColor = false,
    }, row)
    corner(btn, 6)
    local listening = false
    local current = default
    conn(btn.MouseButton1Click, function()
        listening = true
        btn.Text = "..."
    end)
    local c = conn(UserInputService.InputBegan, function(inp)
        if not listening then return end
        if inp.UserInputType ~= Enum.UserInputType.Keyboard then return end
        listening = false
        current = inp.KeyCode
        btn.Text = current.Name
        if callback then callback(current) end
    end)
    table.insert(Connections, c)
    return { get = function() return current end }
end

function UILib.ColorPicker(parent, label, default, callback)
    local row = new("Frame", {
        Size = UDim2.new(1, 0, 0, 28),
        BackgroundTransparency = 1,
    }, parent)
    new("TextLabel", {
        Size = UDim2.new(1, -40, 1, 0),
        BackgroundTransparency = 1,
        Text = label,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextColor3 = Theme.text,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)
    local swatch = new("Frame", {
        Size = UDim2.new(0, 28, 0, 20),
        Position = UDim2.new(1, -28, 0.5, -10),
        BackgroundColor3 = default,
        BorderSizePixel = 0,
    }, row)
    corner(swatch, 5)
    stroke(swatch, Theme.stroke, 1)

    local H, S, V = default:ToHSV()
    local popup = new("Frame", {
        Size = UDim2.new(0, 170, 0, 150),
        Position = UDim2.new(1, -170, 0, 32),
        BackgroundColor3 = Theme.panelLight,
        Visible = false,
        ZIndex = 30,
    }, row)
    corner(popup, 8)
    stroke(popup, Theme.stroke, 1)

    local sv = new("ImageLabel", {
        Size = UDim2.new(1, -16, 0, 80),
        Position = UDim2.new(0, 8, 0, 8),
        BackgroundColor3 = Color3.fromHSV(H, 1, 1),
        BackgroundTransparency = 0,
        Image = "rbxassetid://3700752136",
        ImageColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
    }, popup)
    corner(sv, 4)

    local huebar = new("Frame", {
        Size = UDim2.new(1, -16, 0, 14),
        Position = UDim2.new(0, 8, 0, 108),
        BorderSizePixel = 0,
    }, popup)
    corner(huebar, 3)
    local hueGrad = new("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0.0, Color3.fromHSV(0, 1, 1)),
            ColorSequenceKeypoint.new(0.17, Color3.fromHSV(0.17, 1, 1)),
            ColorSequenceKeypoint.new(0.33, Color3.fromHSV(0.33, 1, 1)),
            ColorSequenceKeypoint.new(0.5, Color3.fromHSV(0.5, 1, 1)),
            ColorSequenceKeypoint.new(0.67, Color3.fromHSV(0.67, 1, 1)),
            ColorSequenceKeypoint.new(0.83, Color3.fromHSV(0.83, 1, 1)),
            ColorSequenceKeypoint.new(1.0, Color3.fromHSV(1, 1, 1)),
        }),
    }, huebar)

    local svDragging = false
    local hueDragging = false
    local function svAt(x, y)
        local px = math.clamp((x - sv.AbsolutePosition.X) / sv.AbsoluteSize.X, 0, 1)
        local py = math.clamp((y - sv.AbsolutePosition.Y) / sv.AbsoluteSize.Y, 0, 1)
        S, V = px, 1 - py
        local col = Color3.fromHSV(H, S, V)
        swatch.BackgroundColor3 = col
        if callback then callback(col) end
    end
    local function hueAt(x)
        local px = math.clamp((x - huebar.AbsolutePosition.X) / huebar.AbsoluteSize.X, 0, 1)
        H = px
        sv.BackgroundColor3 = Color3.fromHSV(H, 1, 1)
        svAt(0, 0) -- keep
        local col = Color3.fromHSV(H, S, V)
        swatch.BackgroundColor3 = col
        if callback then callback(col) end
    end
    conn(sv.InputBegan, function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            svDragging = true; svAt(inp.Position.X, inp.Position.Y)
        end
    end)
    conn(huebar.InputBegan, function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            hueDragging = true; hueAt(inp.Position.X)
        end
    end)
    conn(UserInputService.InputChanged, function(inp)
        if inp.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        if svDragging then svAt(inp.Position.X, inp.Position.Y) end
        if hueDragging then hueAt(inp.Position.X) end
    end)
    conn(UserInputService.InputEnded, function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            svDragging = false; hueDragging = false
        end
    end)
    conn(swatch.InputBegan, function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            popup.Visible = not popup.Visible
        end
    end)
    return {
        get = function()
            return Color3.fromHSV(H, S, V)
        end,
    }
end

-- ============================================================
-- FEATURE MODULE REGISTRY
-- ============================================================
local Registry = { modules = {} }

function Registry.Register(category, name, module)
    module.category = category
    module.name = name
    module.enabled = false
    module.settings = module.settings or {}
    Registry.modules[category] = Registry.modules[category] or {}
    Registry.modules[category][name] = module
end

function Registry.Set(category, name, state)
    local m = Registry.modules[category] and Registry.modules[category][name]
    if not m then return end
    if state and m.Enable then m:Enable() end
    if not state and m.Disable then m:Disable() end
    m.enabled = state
    Config.features[category .. "." .. name] = state
end

function Registry.DisableAll()
    for _, mods in pairs(Registry.modules) do
        for _, m in pairs(mods) do
            if m.enabled and m.Disable then m:Disable() end
            m.enabled = false
        end
    end
end

